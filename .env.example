# Optional server configuration. Never commit your actual credentials.
# python -m backend reads exported environment variables; it does not load .env automatically.
# docker compose reads .env for interpolation.
YT_RENDER_TOKEN=
YT_RENDER_DIR=render-data
YT_ENCODER=libx264
YT_RENDER_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
PIXABAY_API_KEY=
REPLICATE_API_TOKEN=
# Legacy single-model adapter only. The Studio catalog needs just REPLICATE_API_TOKEN.
# Exact model version (64 hexadecimal characters); model inputs depend on that version.
REPLICATE_MODEL_VERSION=
REPLICATE_INPUT_JSON={}
WHISPER_CPP_BINARY=
WHISPER_CPP_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
